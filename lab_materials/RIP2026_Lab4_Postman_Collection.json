{
  "info": {
    "name": "RIP2026 Lab4 Auth Swagger — 5 запросов",
    "description": "Коллекция для показа ЛР4 в Postman. Порядок: 1) GET список заявок как гость -> 401/403. 2) GET список заявок как создатель -> только свои заявки. 3) PUT завершить заявку как создатель -> 403. 4) PUT завершить заявку как модератор -> 200 и обновление полей. 5) GET список заявок как модератор -> все заявки. Перед запуском заполнить переменные baseUrl, userToken, adminToken, battery_life_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "battery_life_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. GET Список заявок как гость (401/403)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/battery_life/all-battery_lives"
      }
    },
    {
      "name": "2. GET Список заявок как создатель",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "url": "{{baseUrl}}/api/battery_life/all-battery_lives"
      }
    },
    {
      "name": "3. PUT Завершить заявку как создатель (403)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}"
        },
        "url": "{{baseUrl}}/api/battery_life/{{battery_life_id}}/finish-battery_life"
      }
    },
    {
      "name": "4. PUT Завершить заявку как модератор (200)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}"
        },
        "url": "{{baseUrl}}/api/battery_life/{{battery_life_id}}/finish-battery_life"
      }
    },
    {
      "name": "5. GET Список заявок как модератор",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/api/battery_life/all-battery_lives"
      }
    }
  ]
}
