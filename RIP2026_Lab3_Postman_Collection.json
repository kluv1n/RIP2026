{
  "info": {
    "name": "RIP2026 Lab3 REST API — 16 запросов",
    "description": "Порядок запуска (чтобы все 16 отработали): 1) Поднять сервер (docker, migrate, seed, go run). 2) В Postman выполнять по шагам: [2] GET корзина → [3] DEL удалить заявку (очистить старый черновик; если черновика не было — может 404). [4] GET список услуг → [5] POST новая услуга (по желанию, для 6–7 хватает типов из seed). [6] POST добавить услугу → [7] POST добавить другую → [8] GET корзина (обязательно: скрипт подставит battery_life_id). [9] GET заявка → [10] PUT м-м (только current_ma и quantity; sort_order не передаётся) → [11] PUT заявка. [12] PUT завершить (ожидаем 403) → [13] PUT сформировать. [1] GET список заявок (уже есть сформированная заявка). [POST Вход модератора] → [14] PUT завершить сформированную → [15] POST регистрация → [16] GET одна услуга. Переменные: baseUrl, battery_life_id (из ответа корзины после шага 8).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "battery_life_id", "value": "1" }
  ],
  "item": [
    {
      "name": "1. GET Список заявок (from-date, to-date, status)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/battery_lives?from-date=2025-01-01&to-date=2026-12-31&status=formed"
      }
    },
    {
      "id": "folder-1",
      "name": "Заявка услуги",
      "item": [
        {
          "id": "req-2",
          "name": "2. GET Иконка корзины",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/battery_lives/cart",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var body = pm.response.json();",
                    "if (body && typeof body.id !== 'undefined') {",
                    "    pm.collectionVariables.set('battery_life_id', body.id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "id": "req-3",
          "name": "3. DEL Удалить заявку",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/battery_lives/{{battery_life_id}}"
          }
        },
        {
          "id": "req-8",
          "name": "8. GET Иконка корзины (повтор)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/battery_lives/cart",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var body = pm.response.json();",
                    "if (body && typeof body.id !== 'undefined') {",
                    "    pm.collectionVariables.set('battery_life_id', body.id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "id": "req-9",
          "name": "9. GET Заявка по ID (посмотреть заявку из 2 услуг)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/battery_lives/{{battery_life_id}}"
          }
        },
        {
          "id": "req-11",
          "name": "11. PUT Изменить заявку",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Подборка товаров для ролика\",\n  \"description\": \"Нагрузочный тест заявки\"\n}" },
            "url": "{{baseUrl}}/api/battery_lives/{{battery_life_id}}"
          }
        },
        {
          "id": "req-12",
          "name": "12. PUT Завершить заявку (ошибка 403)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" },
            "url": "{{baseUrl}}/api/battery_lives/{{battery_life_id}}/finish"
          }
        },
        {
          "id": "req-13",
          "name": "13. PUT Сформировать заявку",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/battery_lives/{{battery_life_id}}/form"
          }
        },
        {
          "id": "req-14",
          "name": "14. PUT Завершить сформированную заявку",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" },
            "url": "{{baseUrl}}/api/battery_lives/{{battery_life_id}}/finish"
          }
        }
      ]
    },
    {
      "id": "folder-2",
      "name": "Услуги",
      "item": [
        {
          "id": "req-4",
          "name": "4. GET Список услуг (с фильтром)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/battery_types?title=литий"
          }
        },
        {
          "id": "req-5",
          "name": "5. POST Новая услуга (картинка и видео)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Тестовая батарея", "type": "text" },
                { "key": "description", "value": "Описание", "type": "text" },
                { "key": "short_description", "value": "Кратко", "type": "text" },
                { "key": "capacity_mah", "value": "2000", "type": "text" },
                { "key": "voltage_v", "value": "3.7", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/api/battery_types"
          }
        },
        {
          "id": "req-16",
          "name": "16. GET Одна услуга",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/battery_types/1"
          }
        }
      ]
    },
    {
      "id": "folder-3",
      "name": "Заявка-услуга (м-м)",
      "item": [
        {
          "id": "req-6",
          "name": "6. POST Добавить услугу в заявку",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"current_ma\": 100,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/battery_life_items/add/1",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var body = pm.response.json();",
                    "if (body && typeof body.id !== 'undefined') {",
                    "    pm.collectionVariables.set('battery_life_id', body.id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "id": "req-7",
          "name": "7. POST Добавить другую услугу в заявку",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"current_ma\": 150,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/battery_life_items/add/2",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var body = pm.response.json();",
                    "if (body && typeof body.id !== 'undefined') {",
                    "    pm.collectionVariables.set('battery_life_id', body.id);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "id": "req-10",
          "name": "10. PUT Изменить поле м-м",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"current_ma\": 250,\n  \"quantity\": 3\n}" },
            "url": "{{baseUrl}}/api/battery_life_items/1/{{battery_life_id}}"
          }
        }
      ]
    },
    {
      "id": "folder-4",
      "name": "Пользователи",
      "item": [
        {
          "id": "req-15",
          "name": "15. POST Регистрация пользователя",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"login\": \"user3\",\n  \"password\": \"pass3\"\n}" },
            "url": "{{baseUrl}}/api/users/register"
          }
        },
        {
          "id": "req-login",
          "name": "POST Вход модератора (перед шагом 14)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"admin\"\n}" },
            "url": "{{baseUrl}}/api/users/login"
          }
        }
      ]
    }
  ]
}
